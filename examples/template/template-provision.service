[Unit]
Description=Sirius OS: provision template on first boot
After=local-fs.target
# Only run once per install
ConditionPathExists=!/etc/sirius-os/template-provisioned

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /usr/libexec/sirius-os/template-provision.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
