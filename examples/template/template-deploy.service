[Unit]
Description=Sirius OS: root-level deployment for template
After=template-provision.service
After=user@1000.service
Before=template.service
Wants=template.service
# Skip if the package has been removed. On the boot after
# rpm-ostree remove, the deploy script is gone but the unit may
# still be queued by multi-user.target before the dormant
# uninstaller removes the symlink. The condition makes systemd
# skip the unit instead of failing to start it.
ConditionPathExists=/usr/libexec/sirius-os/template-deploy.sh

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /usr/libexec/sirius-os/template-deploy.sh
ExecStartPost=/usr/bin/systemctl daemon-reload

[Install]
WantedBy=multi-user.target
